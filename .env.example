# AI-assisted (Claude Code, Opus 5.5) · revisión de Acker: pendiente
#
# Copia este archivo como .env.local y llena los valores. .env.local no se sube al repo.
# Aquí no va ningún valor real.

# Supabase (solo Auth). Dashboard del proyecto → Project Settings → API:
#   "Project URL" y la "Publishable key" (empieza con sb_publishable_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic. console.anthropic.com → API Keys. Solo se usa en el servidor.
ANTHROPIC_API_KEY=

# Modelo que propone el ProfileUpdate. Se puede cambiar sin tocar código.
LLM_MODEL=claude-haiku-5-5

# Postgres de Supabase para Drizzle. Dashboard → Connect → "Transaction pooler" (puerto 6543).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base (Database → Settings si hay que reiniciarla).
# Formato: postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Clave secreta de Supabase (admin API). Dashboard → Project Settings → API Keys → "secret key"
# (empieza con sb_secret_). Solo servidor: la lee lib/supabase/admin.ts para crear la cuenta de la
# persona, poner su código de invitación y borrar la cuenta si el alta falla (spec 002, R-002.16).
# Nunca con prefijo NEXT_PUBLIC_, nunca en el repo ni en el Drive.
SUPABASE_SECRET_KEY=
